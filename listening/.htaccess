# Protect app secrets and internals from direct web access.
<FilesMatch "^(config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>

# Fallback for older Apache.
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.sample\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Block direct access to code/config directories.
# NOTE: the leading (.*/)? matters — this app's folder IS the document root, so
# requests arrive as /includes/db.php with no parent segment. A pattern of the
# form ^/.*/(includes)/ would never match and would protect nothing.
RedirectMatch 403 ^/(.*/)?(includes|migrations|lang|tests)/

# Default document.
DirectoryIndex index.php
