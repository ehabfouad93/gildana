# ── Database ──
DATABASE_URL="postgresql://insights:insights@localhost:5432/insights"

# ── Auth.js ── generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# ── Encryption key for stored OAuth tokens (32 bytes, base64) ──
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me"

# ── Demo mode: connectors return realistic generated data instead of calling APIs ──
DEMO_MODE=true

# ── Platform apps (leave blank until each API is approved) ──
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v17

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ── AI (GEO analysis, report summaries) ──
ANTHROPIC_API_KEY=

# ── Email (password resets, scheduled reports) ──
# e.g. smtp://you%40gildana.net:PASSWORD@smtp.hostinger.com:587   (log:// prints to the log instead)
SMTP_URL=
MAIL_FROM="Gildana Insights <noreply@gildana.net>"

# ── First admin created by `npm run db:seed` ──
SEED_ADMIN_EMAIL="admin@gildana.net"
SEED_ADMIN_PASSWORD="change-me-now"

# Chrome/Chromium for heatmap page snapshots (optional)
CHROMIUM_PATH=
PAGESPEED_API_KEY=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
CLAUDE_MODEL=claude-opus-5-5
