// Gildana Insights — data model.
//
// Tenancy: Client is the tenant. A client (brand or agency) owns many
// Companies; each company owns ad accounts on any platform and websites.
// Every warehouse row carries accountId so a query can be scoped to the
// accounts a user may see with one join.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  VIEWER
}

enum Platform {
  META
  GOOGLE
  LINKEDIN
  SNAPCHAT
  TIKTOK
}

enum Level {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
}

enum SyncStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ShareScope {
  CLIENT
  COMPANY
  PLATFORM
  CAMPAIGN
}

// ───────────────────────── Tenancy ─────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String
  role         Role      @default(CLIENT)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locale       String    @default("en")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  connections AdConnection[]
  resets      PasswordReset[]

  @@index([clientId])
}

model Client {
  id                String   @id @default(cuid())
  name              String
  isAgency          Boolean  @default(false)
  reportingCurrency String   @default("USD")
  timezone          String   @default("Africa/Cairo")
  logoUrl           String   @default("")
  active            Boolean  @default(true)
  onboardedAt       DateTime?
  createdAt         DateTime @default(now())

  users       User[]
  companies   Company[]
  connections AdConnection[]
  shareLinks  ShareLink[]
  claims      AccountClaim[]
}

model Company {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  website   String   @default("")
  industry  String   @default("")
  createdAt DateTime @default(now())

  accounts AdAccount[]
  budgets  Budget[]
  sites    Site[]

  @@index([clientId])
}

/// One OAuth login on one platform. A single login usually exposes many ad
/// accounts, which are then assigned to companies individually.
model AdConnection {
  id          String    @id @default(cuid())
  /// null for Gildana's own (agency) logins, which serve accounts clients share with Gildana.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isAgency    Boolean   @default(false)
  /// Set on a client's "shared with Gildana" connection: the agency login whose token it uses.
  agencySourceId String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    Platform
  label       String    @default("")
  externalUser String   @default("") // platform user/login id
  tokenEnc    String?
  refreshEnc  String?
  expiresAt   DateTime?
  scopes      String    @default("")
  isDemo      Boolean   @default(false)
  status      String    @default("active") // active | expired | revoked | error
  lastError   String    @default("")
  createdAt   DateTime  @default(now())

  accounts AdAccount[]

  @@index([clientId, platform])
}

model AdAccount {
  id           String       @id @default(cuid())
  connectionId String
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  platform     Platform
  externalId   String
  /// Manager account the login reaches this one through (Google MCC login-customer-id).
  parentId     String       @default("")
  name         String
  currency     String       @default("USD")
  timezone     String       @default("UTC")
  enabled      Boolean      @default(true)
  lastSyncAt   DateTime?
  syncError    String       @default("")
  createdAt    DateTime     @default(now())

  campaigns Campaign[]
  adSets    AdSet[]
  ads       Ad[]
  stats     StatDaily[]
  breakdown StatBreakdown[]
  keywords  Keyword[]
  terms     SearchTerm[]
  placements Placement[]
  leads     Lead[]
  syncRuns  SyncRun[]

  @@unique([connectionId, externalId])
  @@index([companyId])
}

// ───────────────────────── Ads structure ─────────────────────────

model Campaign {
  id          String    @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    Platform
  externalId  String
  name        String
  objective   String    @default("")
  status      String    @default("")
  dailyBudget Decimal?  @db.Decimal(14, 2)
  totalBudget Decimal?  @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  raw         Json?
  updatedAt   DateTime  @updatedAt

  adSets AdSet[]
  ads    Ad[]

  @@unique([accountId, externalId])
}

/// Meta ad set · Google ad group · LinkedIn campaign · Snapchat ad squad · TikTok ad group.
model AdSet {
  id               String    @id @default(cuid())
  accountId        String
  account          AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform         Platform
  externalId       String
  name             String
  status           String    @default("")
  optimizationGoal String    @default("")
  bidStrategy      String    @default("")
  dailyBudget      Decimal?  @db.Decimal(14, 2)
  targetingRaw     Json?
  updatedAt        DateTime  @updatedAt

  ads       Ad[]
  targeting TargetingItem[]

  @@unique([accountId, externalId])
  @@index([campaignId])
}

model Ad {
  id          String    @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId     String
  adSet       AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  platform    Platform
  externalId  String
  name        String
  status      String    @default("")
  format      String    @default("") // image | video | carousel | text | search | responsive …
  headline    String    @default("")
  body        String    @default("")
  cta         String    @default("")
  thumbUrl    String    @default("")
  landingUrl  String    @default("")
  previewUrl  String    @default("")
  previewHtml String?
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, externalId])
  @@index([adSetId])
  @@index([campaignId])
}

/// One selected targeting option of an ad set, flattened so it can be grouped
/// and ranked across ad sets ("which interest brings the cheapest leads").
model TargetingItem {
  id         String @id @default(cuid())
  adSetId    String
  adSet      AdSet  @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  type       String // interest | behavior | audience | lookalike | age | gender | geo | placement | keyword | job_title | seniority | industry | company_size | language | device
  value      String
  externalId String @default("")
  exclude    Boolean @default(false)

  @@index([adSetId])
  @@index([type, value])
}

// ───────────────────────── Metrics ─────────────────────────

/// Daily metrics at one level. entityId is the internal id of the account,
/// campaign, ad set or ad. Money is in the ad account's currency.
model StatDaily {
  id          String    @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    Platform
  level       Level
  entityId    String
  campaignId  String?
  adSetId     String?
  date        DateTime  @db.Date
  spend       Decimal   @default(0) @db.Decimal(14, 2)
  impressions Int       @default(0)
  reach       Int       @default(0)
  clicks      Int       @default(0)
  linkClicks  Int       @default(0)
  conversions Decimal   @default(0) @db.Decimal(12, 2)
  leads       Int       @default(0)
  purchases   Int       @default(0)
  value       Decimal   @default(0) @db.Decimal(14, 2)
  videoViews  Int       @default(0)
  engagements Int       @default(0)
  extra       Json?

  @@unique([level, entityId, date])
  @@index([accountId, level, date])
  @@index([campaignId, date])
}

/// Metrics split by one dimension (age, gender, country, placement, hour …)
/// for one entity over one day.
model StatBreakdown {
  id          String    @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    Platform
  level       Level
  entityId    String
  campaignId  String?
  date        DateTime  @db.Date
  dimension   String
  value       String
  spend       Decimal   @default(0) @db.Decimal(14, 2)
  impressions Int       @default(0)
  reach       Int       @default(0)
  clicks      Int       @default(0)
  conversions Decimal   @default(0) @db.Decimal(12, 2)
  leads       Int       @default(0)
  convValue   Decimal   @default(0) @db.Decimal(14, 2)

  @@unique([level, entityId, date, dimension, value])
  @@index([accountId, dimension, date])
  @@index([campaignId, dimension])
}

/// Google Ads keyword with its metrics summed per day.
model Keyword {
  id           String    @id @default(cuid())
  accountId    String
  account      AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId   String
  adSetId      String
  externalId   String
  text         String
  matchType    String
  status       String    @default("")
  qualityScore Int?
  date         DateTime  @db.Date
  spend        Decimal   @default(0) @db.Decimal(14, 2)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  conversions  Decimal   @default(0) @db.Decimal(12, 2)
  value        Decimal   @default(0) @db.Decimal(14, 2)

  @@unique([accountId, externalId, date])
  @@index([campaignId, date])
}

model SearchTerm {
  id          String    @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId  String
  adSetId     String
  term        String
  keywordText String    @default("")
  matchType   String    @default("")
  date        DateTime  @db.Date
  spend       Decimal   @default(0) @db.Decimal(14, 2)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Decimal   @default(0) @db.Decimal(12, 2)

  @@unique([accountId, adSetId, term, date])
  @@index([campaignId, date])
}

/// Where Display / YouTube / app / audience-network traffic was served.
model Placement {
  id          String    @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId  String
  kind        String // website | youtube_channel | youtube_video | mobile_app | publisher
  target      String
  display     String    @default("")
  date        DateTime  @db.Date
  spend       Decimal   @default(0) @db.Decimal(14, 2)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Decimal   @default(0) @db.Decimal(12, 2)

  @@unique([accountId, campaignId, kind, target, date])
  @@index([campaignId, date])
}

model Lead {
  id         String    @id @default(cuid())
  accountId  String
  account    AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform   Platform
  externalId String
  campaignId String?
  adSetId    String?
  adId       String?
  formName   String    @default("")
  createdAt  DateTime
  fields     Json

  @@unique([accountId, externalId])
  @@index([adSetId])
  @@index([campaignId])
}

model FxRate {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  base  String
  quote String
  rate  Decimal  @db.Decimal(18, 8)

  @@unique([date, base, quote])
}

model Budget {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform  Platform?
  month     DateTime  @db.Date
  amount    Decimal   @db.Decimal(14, 2)
  currency  String    @default("USD")

  @@unique([companyId, platform, month])
}

// ───────────────────────── Jobs ─────────────────────────

/// Also the job queue: the worker claims QUEUED rows with SKIP LOCKED.
model SyncRun {
  id         String     @id @default(cuid())
  accountId  String
  account    AdAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       String // full | stats | backfill
  fromDate   DateTime   @db.Date
  toDate     DateTime   @db.Date
  status     SyncStatus @default(QUEUED)
  attempts   Int        @default(0)
  runAfter   DateTime   @default(now())
  error      String     @default("")
  log        String     @default("")
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, runAfter])
  @@index([accountId, createdAt])
}

// ───────────────────────── Sharing ─────────────────────────

model ShareLink {
  id           String     @id @default(cuid())
  token        String     @unique
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String     @default("")
  scope        ShareScope
  companyId    String?
  platform     Platform?
  campaignId   String?
  rangeDays    Int?       // rolling window; null = fixed range below
  fromDate     DateTime?  @db.Date
  toDate       DateTime?  @db.Date
  passwordHash String?
  expiresAt    DateTime?
  views        Int        @default(0)
  createdById  String?
  createdAt    DateTime   @default(now())
}

// ───────────────────────── Websites ─────────────────────────

model Site {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  domain      String   // host without scheme, e.g. example.com — subdomains are accepted too
  trackingKey String   @unique
  replay      Boolean  @default(false) // record sessions for replay
  replayRate  Int      @default(20)    // percent of sessions recorded
  isDemo      Boolean  @default(false)
  // Google Search Console: the property (e.g. "sc-domain:example.com") and an offline refresh token.
  gscProperty   String   @default("")
  gscRefreshEnc String?
  createdAt   DateTime @default(now())

  sessions  TrackSession[]
  goals     Goal[]
  snapshots PageSnapshot[]
  crawls    SeoCrawl[]
  geoAudits GeoAudit[]
  prompts   AiPrompt[]

  @@index([companyId])
}

model TrackSession {
  id          String   @id // "<siteId>:<client session id>"
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visitorId   String
  isNew       Boolean  @default(true)
  startedAt   DateTime
  lastSeenAt  DateTime
  landingPath String   @default("")
  exitPath    String   @default("")
  referrer    String   @default("")
  refHost     String   @default("")
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  utmContent  String   @default("")
  utmTerm     String   @default("")
  clickIdType String   @default("") // gclid | fbclid | ttclid | li_fat_id | ScCid | msclkid
  channel     String   @default("Direct")
  device      String   @default("desktop")
  browser     String   @default("")
  os          String   @default("")
  country     String   @default("")
  city        String   @default("")
  pageviews   Int      @default(0)
  events      Int      @default(0)
  durationSec Int      @default(0)
  maxScroll   Int      @default(0)
  converted   Boolean  @default(false)
  hasReplay   Boolean  @default(false)

  views   TrackPageview[]
  evs     TrackEvent[]
  replays TrackReplay[]

  @@index([siteId, startedAt])
  @@index([siteId, visitorId])
}

model TrackPageview {
  id         String       @id @default(cuid())
  sessionId  String
  session    TrackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  siteId     String
  path       String
  title      String       @default("")
  ts         DateTime
  activeSec  Int          @default(0)
  scrollPct  Int          @default(0) // deepest point seen, % of page height
  viewportW  Int          @default(0)
  viewportH  Int          @default(0)
  docH       Int          @default(0)
  device     String       @default("desktop")
  pvKey      String       @default("") // client page-view id, so the leave beacon can find it

  @@index([siteId, ts])
  @@index([siteId, path, ts])
  @@index([sessionId, pvKey])
}

model TrackEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   TrackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  siteId    String
  path      String
  type      String // click | rage_click | dead_click | form_start | form_submit | custom | conversion
  name      String       @default("")
  value     Float?
  ts        DateTime
  xPct      Float? // click x as % of document width
  yPx       Int? // click y from document top, in CSS px
  docW      Int?
  docH      Int?
  selector  String       @default("")
  text      String       @default("")
  device    String       @default("desktop")

  @@index([siteId, path, type, ts])
  @@index([siteId, type, ts])
}

model TrackReplay {
  id        String       @id @default(cuid())
  sessionId String
  session   TrackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  ts        DateTime
  data      Bytes // gzipped rrweb events (JSON array)

  @@unique([sessionId, seq])
}

/// A session converts when it views a matching path or fires a matching event.
model Goal {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  kind   String // path | event
  match  String // path prefix (e.g. /thank-you) or event name

  @@index([siteId])
}

/// A full-page screenshot used as the heatmap background.
model PageSnapshot {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  path      String
  device    String
  width     Int
  height    Int
  image     Bytes
  createdAt DateTime @default(now())

  @@unique([siteId, path, device])
}

// ───────────────────────── SEO ─────────────────────────

model SeoCrawl {
  id         String    @id @default(cuid())
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status     String    @default("queued") // queued | running | done | failed
  maxPages   Int       @default(200)
  pagesDone  Int       @default(0)
  score      Int?
  summary    Json?
  error      String    @default("")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  pages  SeoPage[]
  issues SeoIssue[]

  @@index([siteId, createdAt])
}

model SeoPage {
  id            String   @id @default(cuid())
  crawlId       String
  crawl         SeoCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url           String
  status        Int
  redirectTo    String   @default("")
  ms            Int      @default(0)
  bytes         Int      @default(0)
  title         String   @default("")
  description   String   @default("")
  h1            String   @default("")
  h1Count       Int      @default(0)
  canonical     String   @default("")
  robots        String   @default("")
  lang          String   @default("")
  wordCount     Int      @default(0)
  internalLinks Int      @default(0)
  externalLinks Int      @default(0)
  images        Int      @default(0)
  imagesNoAlt   Int      @default(0)
  schemaTypes   String   @default("")
  hreflang      String   @default("")
  ogTitle       String   @default("")
  depth         Int      @default(0)

  @@index([crawlId])
}

model SeoIssue {
  id       String   @id @default(cuid())
  crawlId  String
  crawl    SeoCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url      String
  code     String
  severity String // error | warning | notice
  detail   String   @default("")

  @@index([crawlId, code])
}

// ───────────────────────── GEO (AI search) ─────────────────────────

model GeoAudit {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status    String   @default("queued")
  score     Int?
  checks    Json?
  aiReview  String   @default("")
  error     String   @default("")
  createdAt DateTime @default(now())
  finishedAt DateTime?

  @@index([siteId, createdAt])
}

/// A question the brand wants to be the answer to in AI assistants.
model AiPrompt {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  prompt    String
  brand     String
  createdAt DateTime @default(now())

  results AiVisibility[]
}

model AiVisibility {
  id         String   @id @default(cuid())
  promptId   String
  prompt     AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  engine     String
  mentioned  Boolean
  position   Int?     // 1-based order of the brand among brands named, when listed
  cited      Boolean  @default(false) // the brand's domain appears as a source
  competitors String  @default("")
  answer     String
  checkedAt  DateTime @default(now())

  @@index([promptId, checkedAt])
}

/// A Meta ad set split into one ad set per interest, so each interest's
/// results are measured directly instead of estimated.
model InterestTest {
  id            String   @id @default(cuid())
  clientId      String
  accountId     String
  campaignId    String
  sourceAdSetId String
  /// [{ externalId, adSetId?, interest: {type, value, externalId} }]
  arms          Json
  dailyBudget   Decimal? @db.Decimal(14, 2)
  status        String   @default("created") // created | active | ended | failed
  error         String   @default("")
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([campaignId])
}

/// One-time password reset link. Only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String    @default("")
  purpose   String    @default("reset") // reset | invite
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// App-wide settings editable from Admin → Platforms (platform app keys, sign-up, email…).
/// Values are encrypted; an unset key falls back to the environment variable of the same name.
model AppSetting {
  key       String   @id
  valueEnc  String
  updatedAt DateTime @updatedAt
}

/// A client asking for an ad account they shared with Gildana's Business Manager / MCC.
/// An admin approves it, so one client can never pull in another client's account.
model AccountClaim {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId  String?
  platform   Platform
  externalId String
  name       String    @default("")
  visible    Boolean   @default(false) // seen through Gildana's agency login when last checked
  status     String    @default("pending") // pending | approved | rejected
  note       String    @default("")
  accountId  String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@unique([clientId, platform, externalId])
  @@index([status])
}
