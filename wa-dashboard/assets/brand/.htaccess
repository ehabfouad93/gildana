# Uploaded artwork only — never execute anything from this folder.
<FilesMatch "\.(php|phtml|php[0-9]|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php[0-9]|pl|py|cgi|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
php_flag engine off
