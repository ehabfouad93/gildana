# Revenect — nginx site (generated by deploy/vps-setup.sh; __PLACEHOLDERS__ substituted).
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    root __ROOT__;
    index index.php;

    # Uploads and CSV imports; keep in step with php.ini upload_max_filesize.
    client_max_body_size 32M;

    # The service worker must be served from the root so its scope covers the whole app.
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }

    location / { try_files $uri $uri/ =404; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:__PHP_SOCK__;
        # Campaign sends and the "send now" kick can outlive the default 60s.
        fastcgi_read_timeout 300;
    }

    # Secrets and internals must never be served, even if PHP is disabled.
    location ~ ^/(config\.php|config\.sample\.php)$ { deny all; }
    location ^~ /includes/   { deny all; }
    location ^~ /migrations/ { deny all; }
    location ^~ /deploy/     { deny all; }
    location ~ /\.           { deny all; }   # .git, .env, .htaccess…

    # Uploaded files are data, never code.
    location ^~ /uploads/ {
        location ~ \.php$ { deny all; }
        add_header X-Content-Type-Options nosniff;
    }

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log;
}
