# Protect app secrets and internals from direct web access.
<FilesMatch "^(config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>

# Fallback for older Apache
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.sample\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Dotfiles. Apache's stock config protects .ht* and nothing else, so a .env sitting anywhere
# under the document root is served as plain text. Deny the lot rather than name them.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Files people sent on WhatsApp are private: served only through client/media.php, signed in.
RedirectMatch 404 (^|/)uploads/inbound/
RedirectMatch 404 (^|/)uploads/materials/

# The API reads "Authorization: Bearer …"; some PHP setups drop that header unless it is passed on.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Being found (Admin → SEO): these are built from the settings, not files on disk.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]
    RewriteRule ^llms-full\.txt$ llms.php?full=1 [L]
    RewriteRule ^get-started$ request.php [L,QSA]
    RewriteRule ^help-center$ help-center.php [L,QSA]
</IfModule>
